{
  "name": "MyGit",
  "identifier": "io.github.binaryify.mygit",
  "version": "0.3.27-dev",
  "copyright": "Copyright © 2026 binaryify",
  "out": "build",
  "macos": {
    "icon": "assets/AppIcon.icns",
    "infoPlist": {
      "CFBundleDocumentTypes": [
        {
          "CFBundleTypeName": "Folder",
          "CFBundleTypeRole": "Viewer",
          "LSHandlerRank": "Alternate",
          "LSItemContentTypes": [
            "public.folder"
          ]
        }
      ]
    }
  },
  "i18n": {
    "dir": "locales",
    "source": "en"
  }
}
